FROM golang:1.27.3-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/fakenode ./internal/fakenode
COPY tools/fakenode ./tools/fakenode
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/fakenode ./tools/fakenode

FROM alpine:3.20
RUN apk add --no-cache wget
COPY --from=builder /out/fakenode /usr/local/bin/fakenode
EXPOSE 1317 26657 9090 8000
ENTRYPOINT ["/usr/local/bin/fakenode"]
